<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitx_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← BACK"
            android:textColor="@color/fitx_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/fitx_dark"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Your Workout"
            android:textColor="@color/fitx_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What part of your body do you want to train?"
            android:textColor="@color/fitx_gray"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <!-- Chest -->

        <TextView
            android:id="@+id/bodyChest"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="🫁  Chest"
            android:textColor="@color/fitx_white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="25dp" />

        <!-- Arms -->

        <TextView
            android:id="@+id/bodyArms"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="💪  Arms"
            android:textColor="@color/fitx_white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="12dp" />

        <!-- Legs -->

        <TextView
            android:id="@+id/bodyLegs"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="🦵  Legs"
            android:textColor="@color/fitx_white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="12dp" />

        <!-- Core -->

        <TextView
            android:id="@+id/bodyCore"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="🔥  Abs &amp; Core"
            android:textColor="@color/fitx_white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="12dp" />

        <!-- Shoulders -->

        <TextView
            android:id="@+id/bodyShoulders"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="🏋  Shoulders"
            android:textColor="@color/fitx_white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="12dp" />

        <!-- Back -->

        <TextView
            android:id="@+id/bodyBack"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="🔥  Back"
            android:textColor="@color/fitx_white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="12dp" />

        <!-- Full Body -->

        <TextView
            android:id="@+id/bodyFullBody"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="🏃  Full Body"
            android:textColor="@color/fitx_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_workout_card"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>