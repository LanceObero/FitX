<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitx_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← BACK"
            android:textColor="@color/fitx_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/fitx_dark" />

        <TextView
            android:id="@+id/tvExerciseNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXERCISE 1 / 4"
            android:textColor="@color/fitx_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="35dp" />

        <TextView
            android:id="@+id/tvExerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Push-ups"
            android:textColor="@color/fitx_white"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <ImageView
            android:id="@+id/ivExerciseDemo"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerInside"
            android:contentDescription="Exercise demonstration"
            android:background="@drawable/bg_card" />

        <TextView
            android:id="@+id/tvExerciseTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10 reps"
            android:textColor="@color/fitx_gray"
            android:textSize="21sp"
            android:gravity="center"
            android:layout_marginTop="18dp" />

        <!-- Rep Counter -->
        <LinearLayout
            android:id="@+id/repCounterContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnMinusRep"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="−"
                android:textColor="@color/fitx_white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:backgroundTint="@color/fitx_dark" />

            <LinearLayout
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">

                <TextView
                    android:id="@+id/tvRepCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/fitx_primary"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REPS"
                    android:textColor="@color/fitx_gray"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btnPlusRep"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="+"
                android:textColor="@color/fitx_black"
                android:textSize="26sp"
                android:textStyle="bold"
                android:backgroundTint="@color/fitx_primary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvExerciseInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exercise instructions will appear here."
            android:textColor="@color/fitx_white"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvExerciseTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIP: Keep your movement controlled."
            android:textColor="@color/fitx_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COMPLETE THE TARGET"
            android:textColor="@color/fitx_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="30dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="COMPLETE EXERCISE"
            android:textColor="@color/fitx_black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="@color/fitx_primary"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>