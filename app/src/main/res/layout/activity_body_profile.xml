<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitx_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← BACK"
            android:textColor="@color/fitx_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/fitx_dark" />


        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BODY PROFILE"
            android:textColor="@color/fitx_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Know Your Body"
            android:textColor="@color/fitx_white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your basic information to calculate your BMI and personalize your fitness experience."
            android:textColor="@color/fitx_gray"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="10dp" />


        <!-- Age -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGE"
            android:textColor="@color/fitx_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />

        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your age"
            android:textColor="@color/fitx_white"
            android:textColorHint="@color/fitx_gray"
            android:textSize="16sp"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="8dp" />


        <!-- Height -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEIGHT (CM)"
            android:textColor="@color/fitx_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etHeight"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your height in cm"
            android:textColor="@color/fitx_white"
            android:textColorHint="@color/fitx_gray"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="8dp" />


        <!-- Weight -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEIGHT (KG)"
            android:textColor="@color/fitx_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etWeight"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your weight in kg"
            android:textColor="@color/fitx_white"
            android:textColorHint="@color/fitx_gray"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="8dp" />


        <!-- Calculate BMI -->

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CALCULATE BMI"
            android:textColor="@color/fitx_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/fitx_primary"
            android:layout_marginTop="25dp" />


        <!-- BMI Result -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR BMI"
                android:textColor="@color/fitx_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/fitx_primary"
                android:textSize="42sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/tvBmiCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not available"
                android:textColor="@color/fitx_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>


        <!-- Save -->

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SAVE BODY PROFILE"
            android:textColor="@color/fitx_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/fitx_primary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>

